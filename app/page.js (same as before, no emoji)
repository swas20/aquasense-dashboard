"use client"
import { useEffect, useState } from "react";
export default function Dashboard(){
  const [logged,setLogged]=useState(false); const [u,setU]=useState(""); const [p,setP]=useState("");
  const [data,setData]=useState({monitor:null, customers:[], leakage:{}, online:false});
  useEffect(()=>{ if(!logged) return; const t=setInterval(async()=>{ try{ const r=await fetch("/api/telemetry"); const j=await r.json(); setData(j);}catch(e){} },2000); return ()=>clearInterval(t); },[logged]);
  const doLogin = async ()=>{ const r=await fetch("/api/login",{method:"POST", headers:{"Content-Type":"application/json"}, body:JSON.stringify({user:u,pass:p})}); if(r.ok) setLogged(true); else alert("admin / admin123"); }
  const sendCmd = async (cmd)=>{ await fetch(`/api/cmd/set?c=${cmd}`); }
  const pay = async (id)=>{ const amt=prompt("Enter KSh"); if(!amt) return; await fetch("/api/payment",{method:"POST", headers:{"Content-Type":"application/json"}, body:JSON.stringify({id,amount:Number(amt)})}); }
  if(!logged) return (<div style={{height:"100vh",display:"flex",justifyContent:"center",alignItems:"center",background:"#eef2ff"}}><div style={{background:"white",padding:30,borderRadius:15,width:320}}><h2>Login</h2><input placeholder="admin" value={u} onChange={e=>setU(e.target.value)} style={{width:"100%",padding:10,margin:"5px 0"}}/><input type="password" placeholder="admin123" value={p} onChange={e=>setP(e.target.value)} style={{width:"100%",padding:10,margin:"5px 0"}}/><button onClick={doLogin} style={{width:"100%",padding:12,background:"#007bff",color:"white",border:"none",borderRadius:8}}>Login</button></div></div>);
  const hasMonitor=data.monitor&&data.online; const hasCustomers=data.customers&&data.customers.length>0;
  if(!hasMonitor&&!hasCustomers) return (<div style={{padding:50,textAlign:"center"}}><h1>Waiting for meters...</h1></div>);
  return (<div style={{padding:20,background:"#f0f2f5",minHeight:"100vh",fontFamily:"Arial"}}><h1>SMART AQUASENSE</h1>
  {hasMonitor&&<div style={{background:"white",padding:20,borderRadius:10,borderLeft:`10px solid ${data.monitor.valve==="OPEN"?"green":"red"}`}}><h3>MONITOR 0 - {data.monitor.valve}</h3><p>Flow: {data.monitor.flow?.toFixed(2)} L/min</p><p>Total: {data.monitor.total?.toFixed(2)} L</p><button onClick={()=>sendCmd("OPEN_0")} style={{background:"green",color:"white",padding:10,marginRight:10}}>OPEN</button><button onClick={()=>sendCmd("CLOSE_0")} style={{background:"red",color:"white",padding:10}}>CLOSE</button></div>}
  <div style={{background:"#fff3cd",padding:20,margin:"15px 0"}}><h3>AUDIT</h3><p>Customers: {data.leakage?.sum?.toFixed(2)} L</p><p>Monitor: {data.monitor?.total?.toFixed(2)} L</p><h2>Leak: {data.leakage?.total?.toFixed(2)} L ({data.leakage?.percent?.toFixed(1)}%)</h2></div>
  <div style={{display:"flex",flexWrap:"wrap",gap:15}}>{data.customers?.map(c=>(<div key={c.id} style={{background:"white",padding:15,borderRadius:10,minWidth:260,borderLeft:`10px solid ${c.valve==="OPEN"?"green":"red"}`}}><h3>Customer {c.id} - {c.valve}</h3><p>Flow: {c.flow?.toFixed(2)}</p><p>Used: {c.used?.toFixed(2)}</p><p>Paid: {c.paid}</p><p>Remain: {Math.max(0,c.remaining).toFixed(2)}</p><button onClick={()=>sendCmd(`OPEN_${c.id}`)} style={{background:"green",color:"white",padding:8,marginRight:5}}>OPEN</button><button onClick={()=>sendCmd(`CLOSE_${c.id}`)} style={{background:"red",color:"white",padding:8,marginRight:5}}>CLOSE</button><button onClick={()=>pay(c.id)} style={{background:"blue",color:"white",padding:8}}>Pay</button></div>))}</div></div>);
}
